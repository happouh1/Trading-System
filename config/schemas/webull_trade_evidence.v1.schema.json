{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Webull sandbox trade evidence v1",
  "description": "Internal interchange schema. Not an official provider format or proof of authenticity. The strict runtime parser additionally validates unique identities, account equality, UTC causality and terminal order arithmetic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "capture_id",
    "candidate_id",
    "account_id_hash",
    "source_sha256",
    "captured_at",
    "orders",
    "fills",
    "positions"
  ],
  "properties": {
    "schema_version": {
      "const": "WEBULL_TRADE_EVIDENCE.1.0"
    },
    "environment": {
      "const": "SANDBOX"
    },
    "capture_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "account_id_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$"
    },
    "orders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/order"
      }
    },
    "fills": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/fill"
      }
    },
    "positions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/position"
      }
    }
  },
  "$defs": {
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_order_id",
        "client_order_id",
        "account_id_hash",
        "symbol",
        "role",
        "side",
        "quantity",
        "filled_quantity",
        "status",
        "known_at"
      ],
      "properties": {
        "broker_order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "client_order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "account_id_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "role": {
          "enum": [
            "ENTRY",
            "EXIT"
          ]
        },
        "side": {
          "enum": [
            "BUY",
            "SELL"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "filled_quantity": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "FILLED",
            "CANCELLED"
          ]
        },
        "known_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_id",
        "broker_order_id",
        "account_id_hash",
        "quantity",
        "price",
        "fee",
        "currency",
        "executed_at",
        "known_at"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "broker_order_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "account_id_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "price": {
          "type": "string",
          "pattern": "^[0-9]{1,18}(\\.[0-9]{1,8})?$"
        },
        "fee": {
          "type": "string",
          "pattern": "^[0-9]{1,18}(\\.[0-9]{1,8})?$"
        },
        "currency": {
          "const": "USD"
        },
        "executed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "known_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_id",
        "account_id_hash",
        "symbol",
        "role",
        "signed_quantity",
        "observed_at",
        "known_at"
      ],
      "properties": {
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "account_id_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "role": {
          "enum": [
            "BEFORE",
            "AFTER"
          ]
        },
        "signed_quantity": {
          "type": "integer"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        },
        "known_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "(Z|\\+00:00)$"
        }
      }
    }
  }
}
